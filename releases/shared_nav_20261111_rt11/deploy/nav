#!/usr/bin/env bash
set -eo pipefail
nav_script="$(readlink -f "${BASH_SOURCE[0]}")"
nav_root="$(cd "$(dirname "$nav_script")/.." && pwd)"
# Catkin sources shell code generated from its own positional arguments.
load_navigation_environment() {
    source /opt/ros/noetic/setup.bash
    source /home/nvidia/sim2real/install/setup.bash
}
load_navigation_environment
exec "$nav_root/.venv/bin/python" "$nav_root/deploy/navigation_cli.py" "$@"
